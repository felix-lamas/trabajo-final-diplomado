# Copiar a .env.e3.local y reemplazar solo con credenciales de cuentas de prueba.
# Este archivo de ejemplo no contiene credenciales utilizables.
E3_ADMIN_EMAIL=admin@e3.test.invalid
E3_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LOCAL
E3_ORGANIZER_EMAIL=organizer@e3.test.invalid
E3_ORGANIZER_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LOCAL
E3_USER_EMAIL=user@e3.test.invalid
E3_USER_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LOCAL

# Opcional: URLs de entorno de prueba. Sin estas variables se usan los defaults locales.
# E3_WEB_URL=https://trabajo-final-diplomado.onrender.com
# E3_API_URL=https://trabajo-final-diplomado-web.onrender.com
# BASE_WEB_URL=http://localhost:4200
# BASE_API_URL=http://localhost:8080
# E3_ENVIRONMENT=local

# Las pruebas que escriben datos requieren AMBAS confirmaciones y destino privado/local.
# No usar contra producción. Las credenciales mutantes deben pertenecer a usuarios de prueba.
# E3_ALLOW_MUTATIONS=true
# E3_ISOLATED_TEST_ENV=true

# Fixtures reales previamente creados por el flujo normal, si el escenario las necesita.
# E3_FREE_EVENT_ID=
# E3_PAID_EVENT_ID=
# E3_DUPLICATE_EVENT_ID=
# E3_TEST_PAYMENT_ID=
# E3_INVALID_FILE_PAYMENT_ID=
# E3_QR_EVENT_ID=
# E3_ELIGIBLE_INSCRIPTION_ID=
# E3_CERTIFICATE_CODE=

# Opciones de monitoreo/rendimiento: se deben proporcionar explícitamente.
# E3_AVAILABILITY_PERIOD_HOURS=24
# E3_AVAILABILITY_INTERVAL_SECONDS=60
# E3_PERFORMANCE_SAMPLES=1
