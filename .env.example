# Copia este archivo como .env y reemplaza los marcadores antes de ejecutar el proyecto.
# .env es local, contiene secretos y no debe versionarse.

# PostgreSQL
DB_NAME=nombre_base_local
DB_USER=usuario_local
DB_PASS=<definir-contrasena-local>
DB_HOST=localhost
DB_PORT=5432

# JWT: usar una clave Base64 distinta y segura para cada entorno.
JWT_SECRET=<definir-secreto-jwt-base64>
JWT_EXPIRATION=86400000

# Aplicación
SERVER_PORT=8080
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/auth/reset-contrasena
MAIL_FROM=no-reply@example.invalid
UPLOADS_BASE_DIR=uploads

# pgAdmin (solo desarrollo)
PGADMIN_EMAIL=admin@example.invalid
PGADMIN_PASSWORD=<definir-contrasena-pgadmin-local>

# Exclusiva para usuarios semilla de demostración/desarrollo.
DEMO_PASSWORD=<definir-contrasena-demo-local>
