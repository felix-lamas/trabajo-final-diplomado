# Copy this file to .env and replace every placeholder before running the project.
# The .env file is local only and must never be committed.

# PostgreSQL
DB_NAME=uajms_eventos
DB_USER=uajms_admin
DB_PASS=REEMPLAZAR_CON_CONTRASENA_LOCAL_SEGURA
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_SEGURO
JWT_EXPIRATION=86400000

# Application
SERVER_PORT=8080
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/auth/reset-contrasena
MAIL_FROM=no-reply@example.invalid
UPLOADS_BASE_DIR=uploads

# pgAdmin (development only)
PGADMIN_EMAIL=admin@example.invalid
PGADMIN_PASSWORD=REEMPLAZAR_CON_CONTRASENA_LOCAL_SEGURA
## Solo para datos semilla de desarrollo/demo. No usar una credencial de producción.
DEMO_PASSWORD=contrasena_demo_de_ejemplo
